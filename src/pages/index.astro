---
import Default from "../layouts/Default.astro";
import HardwareOverview from "../components/HardwareOverview.astro";
import { getProjects, stackList } from "../projects";
const projects = await getProjects();
---
<Default nav="home">
  <div class="home-sections">
  <section aria-labelledby="about-title">
    <h2 class="home-section-title" id="about-title"><span class="command-prompt" aria-hidden="true">$</span> <span class="terminal-command">whoami</span></h2>
    <div class="home-intro">
      <p>By day, I work with systems, from DevOps and cloud to security, keeping the blinking lights <span class="inline-device-led" aria-hidden="true"></span> green and the servers going <span class="inline-accent">brrr</span>. By night, I tend to my mini homelab, self-host things, and learn by breaking them. I break things during the day too, though.<svg class="inline-text-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="currentColor"><path d="M9 2h2v4H9zM7 6h2v2H7zM5 8h2v2H5zm8 2h2v2h-2zm2-2h2v2h-2zm2 2h2v2h-2zm2 2h2v6h-2zM3 10h2v8H3zm8-4h2v4h-2zm6 12h2v2h-2zM7 20h10v2H7zm-2-2h2v2H5zm4-2h6v4H9z"/><path d="M11 14h2v3h-2z"/></g></svg></p>
    </div>
  </section>
  <section class="project-list" aria-labelledby="latest-projects-title">
    <h2 class="home-section-title" id="latest-projects-title"><span class="command-prompt" aria-hidden="true">$</span> <span class="terminal-command">ls -t projects | head -n 2</span></h2>
    <div class="ls-output">
    {projects.slice(0, 2).map((project) => (
      <article class="ls-row">
        <time datetime={project.data.date.toISOString()}>{project.data.date.toISOString().slice(0, 10)}</time>
        <a class="ls-name" href={`/projects/${project.id}`} title={project.data.title}>{project.id}/</a>
        <span class="ls-desc">{project.data.subtitle}</span>
        <span class="ls-stack">{stackList(project.data.stack).map((technology) => `[${technology.toLowerCase()}]`).join(" ")}</span>
      </article>
    ))}
    </div>
  </section>
  <section aria-labelledby="topology-section-title">
  <h2 class="home-section-title" id="topology-section-title"><span class="command-prompt" aria-hidden="true">$</span> <span class="terminal-command">homelab status</span></h2>
  <p class="status-checked" data-status-summary aria-live="polite"># checking…</p>
  <HardwareOverview />
  </section>
  <p class="home-section-title terminal-idle" aria-hidden="true"><span class="command-prompt">$</span> <span class="terminal-cursor terminal-cursor-blink"></span></p>
  </div>
</Default>

<script>
  import "../scripts/healthchecks-status";
  import "../scripts/hardware-activity";
  import "../scripts/hardware-connections";
  import "../scripts/hardware-traffic";
</script>
