---
import Default from "../layouts/Default.astro";
import { getProjects, stackList } from "../projects";
const projects = await getProjects();
---
<Default title="Projects" nav="projects">
  <h1><span class="command-prompt" aria-hidden="true">$</span> Projects</h1>
  <div class="project-list projects-page-list">
    <div class="list-label" aria-hidden="true"><span>DATE</span><span>PROJECT</span><span>STACK</span></div>
    {projects.map((project) => (
      <article class="project-row">
        <time datetime={project.data.date.toISOString()}>{project.data.date.toISOString().slice(0, 10)}</time>
        <div class="project-details"><a href={`/projects/${project.id}`}>{project.data.title}</a> <span class="project-description">{project.data.subtitle}</span></div>
        <span class="project-stack" aria-label={`Stack: ${project.data.stack ?? "not specified"}`}>{project.data.stack ? stackList(project.data.stack).map((technology) => <span>[{technology}]</span>) : "—"}</span>
      </article>
    ))}
  </div>
</Default>
