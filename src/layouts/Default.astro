---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.scss";
export interface Props { title?: string; description?: string; nav?: string; canonical?: string; }
const { title, description, nav, canonical } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" transition:animate="none">
  <Head title={title} description={description} nav={nav} canonical={canonical} />
  <body>
    <div class="site">
      <Header nav={nav} />
      <main><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<script>
  import "../scripts/theme-switch";
  import "../scripts/post-image-zoom";
  import "../scripts/terminal-intro";
</script>
