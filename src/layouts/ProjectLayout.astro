---
import Default from "./Default.astro";
export interface Props { title: string; icon?: string; date: Date; subtitle?: string; link?: string; nav?: string; }
const { title, date, subtitle, link, nav = "projects" } = Astro.props;
---
<Default title={title} nav={nav}>
  <article class="posttext">
    <h1>{title}</h1>
    <p class="post-meta"><a href="/projects">← projects</a> · <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>{link && <> · <a href={link}>project link ↗</a></>}</p>
    {subtitle && <p class="post-subtitle">{subtitle}</p>}
    <slot />
  </article>
</Default>
