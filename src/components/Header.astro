<header class="site-header">
  <a class="site-name" href="/"><video transition:persist="minimal-logo" id="logo-video" class="site-logo" src="/assets/images/darkme.webm" data-dark-src="/assets/images/darkme.webm" data-light-src="/assets/images/lightme.webm" width="48" height="48" autoplay muted loop playsinline aria-hidden="true"></video><span id="minimal-name" class="header-glitch" data-text="krovs" transition:persist="minimal-name" aria-hidden="true">krovs</span><span class="sr-only">krovs</span></a>
  <p>devops, homelab &amp; infosec</p>
  <nav aria-label="Main navigation">
    <a href="/" aria-current={nav === "home" ? "page" : undefined}>home</a>
    <a href="/projects" aria-current={nav === "projects" ? "page" : undefined}>projects</a>
    <a href="/homelab" aria-current={nav === "homelab" ? "page" : undefined}>homelab</a>
    <a href="https://krovs.github.io/seclogs/" target="_blank" rel="noopener noreferrer" aria-label="seclogs (opens in a new tab)">seclogs↗</a>
  </nav>
</header>

<script>
  import "../scripts/name-glitch";
