{
  "name": "krovs",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun -e \"require('node:fs').rmSync('.astro/data-store.json', { force: true })\" && bun ./node_modules/astro/bin/astro.mjs dev",
    "build": "bun ./node_modules/astro/bin/astro.mjs check && bun ./node_modules/astro/bin/astro.mjs build",
    "preview": "bun ./node_modules/astro/bin/astro.mjs preview",
    "astro": "bun ./node_modules/astro/bin/astro.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^7.0.3",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "@astrojs/markdown-satteri": "^0.3.2"
  }
}
